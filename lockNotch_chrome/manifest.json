{
  "name": "LockNotch Downloads",
  "description": "Envia eventos de descargas de Chrome a LockNotch",
  "version": "1.0",
  "manifest_version": 3,
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "nativeMessaging",
    "offscreen",
    "geolocation"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}