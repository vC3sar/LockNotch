<Window x:Class="LockNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centro de Control - LockNotch" Height="550" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" Foreground="White"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">

    <Window.Resources>
        <!-- Estilo de TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <!-- Estilo de TextBox Moderno -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de ToggleButton (Interruptor) -->
        <Style TargetType="CheckBox" x:Key="ToggleSwitchStyle">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Cursor="Hand">
                            <Border x:Name="Switch" Width="40" Height="20" CornerRadius="10" Background="#333333" BorderBrush="#555555" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#999999" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Switch" Property="Background" Value="#34D399"/>
                                <Setter TargetName="Switch" Property="BorderBrush" Value="#34D399"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="Black"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilos de Botones -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#34D399"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Item de Menú Lateral -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Borde Principal (Glassmorphism Oscuro) -->
    <Border Background="#161616" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <!-- Barra de Título Arrastrable -->
            <Border Height="36" Background="Transparent" VerticalAlignment="Top" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Ajustes de LockNotch" FontWeight="SemiBold" FontSize="13" Foreground="#888" VerticalAlignment="Center" Margin="16,0"/>
            </Border>

            <!-- Layout Central -->
            <Grid Margin="0,36,0,70">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Barra Lateral -->
                <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,1,0" Background="#111111">
                    <ListBox x:Name="NavMenu" Background="Transparent" BorderThickness="0" Foreground="#AAA" SelectionChanged="NavMenu_SelectionChanged" SelectedIndex="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="General" FontSize="15"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="App Launcher" FontSize="15"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Clima y Hardware" FontSize="15"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Acerca de" FontSize="15"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Border>

                <!-- Contenido Dinámico -->
                <Border Grid.Column="1" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Background="#1A1A1A" Padding="32">
                    <Grid>
                        <!-- TAB GENERAL -->
                        <StackPanel x:Name="TabGeneral" Visibility="Visible">
                            <TextBlock Text="Configuración General" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,24"/>
                            
                            <TextBlock Text="Arranque del Sistema" FontSize="16" FontWeight="SemiBold" Foreground="#34D399" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkStartWindows" Content="Iniciar LockNotch automáticamente al encender Windows" Style="{StaticResource ToggleSwitchStyle}" Foreground="#DDD"/>
                            
                            <TextBlock Text="Comportamiento del Notch" FontSize="16" FontWeight="SemiBold" Foreground="#34D399" Margin="0,20,0,8"/>
                            <CheckBox x:Name="ChkHideFullscreen" Content="Ocultar automáticamente al jugar o usar apps a pantalla completa" Style="{StaticResource ToggleSwitchStyle}" Foreground="#DDD"/>
                        </StackPanel>

                        <!-- TAB APP LAUNCHER -->
                        <StackPanel x:Name="TabApps" Visibility="Collapsed">
                            <TextBlock Text="Accesos Rápidos" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                            <TextBlock Text="Configura los comandos o rutas de las aplicaciones del carrusel." Foreground="#888" Margin="0,0,0,24"/>
                            
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="300">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="1. Aplicación Principal" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtApp1" ToolTip="Ej: chrome.exe o C:\App\app.exe"/>

                                    <TextBlock Text="2. Segunda Aplicación" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtApp2"/>

                                    <TextBlock Text="3. Tercera Aplicación" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtApp3"/>

                                    <TextBlock Text="4. Cuarta Aplicación" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtApp4"/>

                                    <TextBlock Text="5. Quinta Aplicación" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtApp5"/>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- TAB CLIMA -->
                        <StackPanel x:Name="TabWeather" Visibility="Collapsed">
                            <TextBlock Text="Clima y Sensores" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                            <TextBlock Text="Ajusta tu ubicación y métricas para la pantalla compacta." Foreground="#888" Margin="0,0,0,24"/>

                            <TextBlock Text="Coordenadas (Open-Meteo)" FontSize="16" FontWeight="SemiBold" Foreground="#34D399" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Latitud"/>
                                    <TextBox x:Name="TxtLat"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Longitud"/>
                                    <TextBox x:Name="TxtLon"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="Auto-detectar ubicación (IP)" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="AutoDetectLocation_Click" Margin="0,0,0,8" Padding="12,6" FontSize="13"/>

                            <TextBlock Text="Unidades" FontSize="16" FontWeight="SemiBold" Foreground="#34D399" Margin="0,20,0,8"/>
                            <CheckBox x:Name="ChkFahrenheit" Content="Usar grados Fahrenheit (°F) en lugar de Celsius (°C)" Style="{StaticResource ToggleSwitchStyle}" Foreground="#DDD"/>

                            <TextBlock Text="Intervalo de Refresco Hardware" FontSize="16" FontWeight="SemiBold" Foreground="#34D399" Margin="0,20,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TxtRefresh" Width="60" Margin="0,0,8,0" TextAlignment="Center"/>
                                <TextBlock Text="segundos" VerticalAlignment="Center" Margin="0,0,0,16"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- TAB ACERCA DE -->
                        <StackPanel x:Name="TabAbout" Visibility="Collapsed">
                            <TextBlock Text="Acerca de LockNotch" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,24"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="64" Height="64" Background="#333" CornerRadius="16" Margin="0,0,16,0">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LockNotch" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Versión 1.0.0" Foreground="#888"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="#222" CornerRadius="8" Padding="16" Margin="0,16">
                                <StackPanel>
                                    <TextBlock Text="Hecho con ❤️ para entusiastas de lo aesthetic y aprecio a lo que Dios ha creado." 
                                               Foreground="#DDD" FontSize="15" TextWrapping="Wrap" LineHeight="24" FontStyle="Italic"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Desarrollado y conceptualizado para llevar la experiencia premium al escritorio de Windows." Foreground="#888" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Barra Inferior (Guardar/Cancelar) -->
            <Border VerticalAlignment="Bottom" Height="70" Background="#111" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,12,0"/>
                    <Button Content="Guardar y Aplicar" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
